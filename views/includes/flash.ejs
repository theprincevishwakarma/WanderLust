<!-- Success -->
<% if(success && success.length){ %>
    <div class="alert alert-success alert-dismissible fade show col-9 offset-3 col-sm-8 offset-sm-3 col-md-6 offset-md-4 col-lg-6 offset-lg-3" role="alert"><%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
<% } %>

<!-- error -->
<% if(error && error.length){ %>
    <div class="alert alert-danger alert-dismissible fade show col-9 offset-3 col-sm-8 offset-sm-3 col-md-6 offset-md-4 col-lg-6 offset-lg-3" role="alert"><%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
<% } %>
