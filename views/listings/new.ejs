<% layout("/layouts/boilerplate") -%>

<div class="row mt-3 title">
  <div class="mt-5 col-8 offset-2">
    <h3>Create a New StayNest</h3>
    <form
      action="/listings"
      method="POST"
      class="needs-validation"
      enctype="multipart/form-data"
      novalidate
    >
      <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input
          type="text"
          name="listing[title]"
          placeholder="Add a catchy title"
          class="form-control"
          required
        />
        <div class="valid-feedback">
          Perfect! Your StayNest has a great title.
        </div>
        <div class="invalid-feedback">
          Please enter a title for your StayNest.
        </div>
      </div>
      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea
          name="listing[description]"
          class="form-control"
          placeholder="Discribe Your StayNest"
          required
        ></textarea>
        <div class="valid-feedback">
          Looks good! Guests will know what to expect.
        </div>
        <div class="invalid-feedback">
          Please add a short description of your StayNest.
        </div>
      </div>
      <div class="mb-3">
        <label for="image" class="form-label">Image</label>
        <input
          type="file"
          accept="image/*"
          name="listing[image]"
          class="form-control"
          required
        />
        <div class="valid-feedback">Great! Your Image is ready.</div>
        <div class="invalid-feedback">Please upload your StayNest Image</div>
      </div>
      <div class="row">
        <div class="mb-3 col-md-4">
          <label for="price" class="form-label">Price</label>
          <input
            name="listing[price]"
            placeholder="1200"
            class="form-control"
            required
          />
          <div class="valid-feedback">Price looks good!</div>
          <div class="invalid-feedback">Please enter a valid price.</div>
        </div>
        <div class="mb-3 col-md-8">
          <label for="country" class="form-label">Country</label>
          <input
            type="text"
            name="listing[country]"
            placeholder="India"
            class="form-control"
            required
          />
          <div class="valid-feedback">Country added successfully.</div>
          <div class="invalid-feedback">Please enter a valid country name.</div>
        </div>
      </div>
      <div class="row">
        <div class="mb-3 col-md-4">
          <label for="category" class="form-label">Category</label>

          <select
            name="listing[category]"
            id="category"
            class="form-select"
            required
          >
            <option value="rooms" selected disabled>Rooms</option>
            <option value="trending">Trending</option>
            <option value="iconic Cities">Iconic Cities</option>
            <option value="food">Food</option>
            <option value="mountains">Mountains</option>
            <option value="castles">Castles</option>
            <option value="amazing Pools">Amazing Pools</option>
            <option value="camping">Camping</option>
            <option value="farms">Farms</option>
            <option value="arctic">Arctic</option>
            <option value="cottage">Cottage</option>
            <option value="apartment">Apartment</option>
          </select>

          <div class="valid-feedback">
            Great! Your StayNest category has been selected.
          </div>

          <div class="invalid-feedback">
            Please select a category for your StayNest.
          </div>
        </div>
        <div class="mb-3 col-md-8">
          <label for="location" class="form-label">Location</label>
          <input
            type="text"
            name="listing[location]"
            placeholder="Jaunpur, Uttar Pradesh"
            class="form-control"
            required
          />
          <div class="valid-feedback">Great location!</div>
          <div class="invalid-feedback">Please enter a valid location.</div>
        </div>
      </div>
      <button class="btn btn-dark mt-3 add-btn btn-red btn-search">Add</button>
      <br /><br />
    </form>
  </div>
</div>
