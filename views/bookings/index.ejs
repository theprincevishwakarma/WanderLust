<% layout("/layouts/boilerplate") %>

    <% const pad=(n)=> String(n).padStart(2, "0");
        const toLocalISO = (dt) => `${dt.getFullYear()}-${pad(dt.getMonth() + 1)}-${pad(dt.getDate())}`;
        const MONTHS = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
        const fmtDay = (dt) => pad(dt.getDate()) + " " + MONTHS[dt.getMonth()];
        const fmtFull = (dt) => fmtDay(dt) + " " + dt.getFullYear();

        const currDate = new Date();
        const leftHours = 24 - currDate.getHours();

        const d = new Date();
        d.setDate(d.getDate() + 1);

        const demoCheckIn = toLocalISO(currDate);
        const demoCheckOut = toLocalISO(d);
        const demoGuests = 1;
        const demoNights = 1;
        const nightlyPrice = Number(listing.price) || 0;
        const roomTotal = Math.round(nightlyPrice * demoNights * 100) / 100;
        const TAX_RATE = 0.18;
        const demoTax = Math.round(roomTotal * TAX_RATE * 100) / 100;
        const demoTotal = Math.round((roomTotal + demoTax) * 100) / 100;
        const formatPrice = (p) => Number(p).toLocaleString("en-IN", {
        minimumFractionDigits: 2, maximumFractionDigits: 2
        });
        %>

        <div class=" sn-checkout-page title">
            <div class="sn-checkout-container">

                <!-- PAGE HEADER -->
                <header class="sn-checkout-header">
                    <a href="/listings/<%= listing._id %>" class="sn-back-button elevation-2"
                        aria-label="Go back to property">
                        <i class="fa-solid fa-arrow-left"></i>
                    </a>

                    <h1>Confirm and pay</h1>
                </header>

                <!-- CHECKOUT GRID -->
                <div class="sn-checkout-grid">

                    <!-- LEFT: PAYMENT SECTION -->
                    <main class="sn-payment-column">

                        <section class="sn-payment-section">
                            <div class="sn-payment-heading">
                                <h2>Proceed to payment</h2>
                                <p>You’ll be directed to Razorpay to complete your payment.</p>
                            </div>

                            <div class="sn-payment-divider"></div>

                            <p class="sn-terms-text">
                                By selecting the button, I agree to the
                                <a href="/terms" class="sn-inline-link">booking terms</a>.
                            </p>

                            <form action="/api/payment/<%= listing._id %>" method="POST" id="sn-checkout-form">
                                <input type="hidden" name="booking[checkIn]" id="sn-hidden-checkin"
                                    value="<%= demoCheckIn %>">

                                <input type="hidden" name="booking[checkOut]" id="sn-hidden-checkout"
                                    value="<%= demoCheckOut %>">

                                <input type="hidden" name="booking[guests]" id="sn-hidden-guests"
                                    value="<%= demoGuests %>">

                                <button type="submit" class="sn-payment-button">
                                    <span class="title" style="color:rgb(255, 255, 255);">Continue to
                                        payment</span>
                                    <i class="fa-solid fa-arrow-right"></i>
                                </button>
                            </form>

                            <p class="sn-payment-note">
                                <i class="fa-solid fa-lock"></i>
                                Secure checkout experience
                            </p>
                        </section>

                    </main>

                    <!-- RIGHT: BOOKING SUMMARY -->
                    <aside class="sn-summary-column">

                        <!-- TIME ALERT -->
                        <div class="sn-booking-alert elevation-1">
                            <span class="sn-alert-icon">
                                <i class="fa-regular fa-clock"></i>
                            </span>

                            <span>Only <%= leftHours %> hours left to book your dates</span>
                        </div>

                        <!-- PROPERTY AND PRICE CARD -->
                        <section class="sn-summary-card elevation-2">

                            <!-- PROPERTY -->
                            <div class="sn-property">
                                <a href="/listings/<%= listing._id %>" class="sn-property-image-link">
                                    <img src="<%= listing.image.url %>" alt="<%= listing.title %>"
                                        class="sn-property-image">
                                </a>

                                <div class="sn-property-info">
                                    <h2>
                                        <%= listing.title %>
                                    </h2>

                                    <p class="sn-property-location">
                                        <i class="fa-solid fa-location-dot"></i>
                                        <%= listing.location %>, <%= listing.country %>
                                    </p>

                                    <div class="sn-property-rating">
                                        <i class="fa-solid fa-star"></i>
                                        <span>New</span>
                                    </div>
                                </div>
                            </div>

                            <!-- CANCELLATION POLICY -->
                            <div class="sn-cancellation">
                                <p>
                                    Partial refund: Get back every night that remains
                                    24 hours after you cancel. No refund of the nights
                                    you've spent or the service fee.
                                    <a href="/terms" class="sn-inline-link">Full policy</a>
                                </p>
                            </div>

                            <!-- DATES -->
                            <div class="sn-summary-section">
                                <div class="sn-summary-detail">
                                    <h3>Dates</h3>

                                    <p id="sn-display-dates">
                                        <%= fmtDay(currDate) %> – <%= fmtFull(d) %>
                                    </p>

                                    <p class=" sn-muted-text">
                                        2:00 pm check-in · 11:00 am check-out
                                    </p>
                                </div>

                                <button type="button" class="sn-change-button" data-bs-toggle="modal"
                                    data-bs-target="#snDatesModal">
                                    Change
                                </button>
                            </div>

                            <!-- GUESTS -->
                            <div class="sn-summary-section">
                                <div class="sn-summary-detail">
                                    <h3>Guests</h3>
                                    <p id="sn-display-guests">1 adult</p>
                                </div>

                                <button type="button" class="sn-change-button" data-bs-toggle="modal"
                                    data-bs-target="#snGuestsModal">
                                    Change
                                </button>
                            </div>

                            <!-- PRICE DETAILS -->
                            <div class="sn-price-section">
                                <h3>Price details</h3>

                                <div class="sn-price-row">
                                    <span>
                                        <span id="sn-nights">
                                            <%= demoNights %>
                                        </span>
                                        <span id="sn-nights-label">
                                            <%= demoNights===1 ? "night" : "nights" %>
                                        </span>
                                        × ₹<span id="sn-nightly-price">
                                            <%= formatPrice(nightlyPrice) %>
                                        </span>
                                    </span>
                                    <span id="sn-room-total">₹<%= formatPrice(roomTotal) %></span>
                                </div>

                                <div class="sn-price-row" id="sn-extra-row" hidden>
                                    <span id="sn-extra-label">Extra guests</span>
                                    <span id="sn-extra-total">₹0.00</span>
                                </div>

                                <div class="sn-price-row">
                                    <span>Taxes (18% demo)</span>

                                    <span id="sn-tax-total">
                                        ₹<%= formatPrice(demoTax) %>
                                    </span>
                                </div>

                                <div class="sn-price-divider"></div>

                                <div class="sn-total-row">
                                    <strong>Total <span>INR</span></strong>

                                    <strong id="sn-grand-total">
                                        ₹<%= formatPrice(demoTotal) %>
                                    </strong>
                                </div>

                                <button type="button" class="sn-breakdown-button" id="sn-breakdown-toggle"
                                    aria-expanded="false">
                                    <span>Price breakdown</span>
                                    <i class="fa-solid fa-chevron-down"></i>
                                </button>

                                <div class="sn-breakdown-details" id="sn-breakdown">
                                    <div class="sn-breakdown-row">
                                        <span>Accommodation</span>
                                        <span id="sn-breakdown-room">
                                            ₹<%= formatPrice(roomTotal) %>
                                        </span>
                                    </div>

                                    <div class="sn-breakdown-row">
                                        <span>Estimated taxes</span>
                                        <span id="sn-breakdown-tax">
                                            ₹<%= formatPrice(demoTax) %>
                                        </span>
                                    </div>

                                    <p>
                                        Taxes are illustrative demo values and must
                                        be verified before real bookings.
                                    </p>
                                </div>
                            </div>

                        </section>

                    </aside>

                </div>
            </div>
        </div>

        <!-- DATE MODAL -->
        <div class="modal fade" id="snDatesModal" tabindex="-1" aria-labelledby="snDatesModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content sn-modal-content">

                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="snDatesModalLabel">
                            Change your dates
                        </h2>

                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body sn-modal-body">
                        <div class="sn-modal-field">
                            <label for="sn-checkin">Check-in</label>
                            <input type="date" id="sn-checkin" class="form-control" min="<%= demoCheckIn %>"
                                value="<%= demoCheckIn %>">
                        </div>

                        <div class="sn-modal-field">
                            <label for="sn-checkout">Check-out</label>
                            <input type="date" id="sn-checkout" class="form-control" min="<%= demoCheckOut %>"
                                value="<%= demoCheckOut %>">
                        </div>

                        <p class="sn-date-error" id="sn-date-error"></p>
                    </div>

                    <div class="modal-footer sn-modal-footer">
                        <button type="button" class="sn-save-button" id="sn-save-dates">
                            Save dates
                        </button>
                    </div>

                </div>
            </div>
        </div>

        <!-- GUEST MODAL -->
        <div class="modal fade" id="snGuestsModal" tabindex="-1" aria-labelledby="snGuestsModalLabel"
            aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content sn-modal-content">

                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="snGuestsModalLabel">Who's coming?</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body sn-modal-body">
                        <div class="sn-guest-control">
                            <div>
                                <h3>Adults</h3>
                                <p>Ages 13 or above</p>
                            </div>
                            <div class="sn-guest-counter">
                                <button type="button" id="sn-minus-guest" aria-label="Decrease guests">−</button>
                                <span id="sn-guest-count">1</span>
                                <button type="button" id="sn-plus-guest" aria-label="Increase guests">+</button>
                            </div>
                        </div>
                        <p class="sn-guest-note">
                            Maximum 16 guests in this demo. Actual capacity must be checked against the property.
                        </p>
                    </div>

                    <div class="modal-footer sn-modal-footer">
                        <button type="button" class="sn-save-button" data-bs-dismiss="modal">Done</button>
                    </div>

                </div>
            </div>
        </div>

        <script>
            document.addEventListener("DOMContentLoaded", () => {
                /* ---------- CONSTANTS + HELPERS ---------- */
                const $ = (id) => document.getElementById(id);
                const NIGHTLY = Number("<%= nightlyPrice %>") || 0;
                const TAX_RATE = Number("<%= TAX_RATE %>");
                const MAX_GUESTS = 16;
                const BASE_GUESTS = 2;     // guests included in the nightly price
                const EXTRA_FEE = NIGHTLY;   // ₹ per extra guest per night
                const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

                const pad = (n) => String(n).padStart(2, "0");
                const toISO = (d) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
                const parse = (v) => new Date(v + "T00:00:00");
                const fmtDay = (d) => pad(d.getDate()) + " " + MONTHS[d.getMonth()];
                const fmtFull = (d) => fmtDay(d) + " " + d.getFullYear();
                const money = (n) => "₹" + n.toLocaleString("en-IN", {
                    minimumFractionDigits: 2, maximumFractionDigits: 2
                });

                /* ---------- STATE ---------- */
                let guests = 1;

                /* ---------- SHARED PRICE CALCULATION ---------- */
                function recalc() {
                    const inDate = parse($("sn-hidden-checkin").value);
                    const outDate = parse($("sn-hidden-checkout").value);
                    const nights = Math.max(1, Math.round((outDate - inDate) / 86400000));

                    const extraGuests = Math.max(0, guests - BASE_GUESTS);
                    const extra = extraGuests * EXTRA_FEE * nights;           // extra-guest fee
                    const room = Math.round(NIGHTLY * nights * 100) / 100;   // base stay
                    const tax = Math.round((room + extra) * TAX_RATE * 100) / 100;
                    const total = Math.round((room + extra + tax) * 100) / 100;

                    $("sn-nights").textContent = nights;
                    $("sn-nights-label").textContent = nights === 1 ? "night" : "nights";
                    $("sn-room-total").textContent = money(room);

                    // Extra guests row: only visible when there are extra guests
                    const extraRow = $("sn-extra-row");
                    extraRow.hidden = extraGuests === 0;
                    $("sn-extra-label").textContent =
                        `Extra guests (${extraGuests} × ₹${EXTRA_FEE} × ${nights} ${nights === 1 ? "night" : "nights"})`;
                    $("sn-extra-total").textContent = money(extra);

                    $("sn-tax-total").textContent = money(tax);
                    $("sn-grand-total").textContent = money(total);
                    $("sn-breakdown-room").textContent = money(room + extra);
                    $("sn-breakdown-tax").textContent = money(tax);
                    $("sn-hidden-total-price").value = total;
                }

                /* ---------- DATES ---------- */
                const checkin = $("sn-checkin");
                const checkout = $("sn-checkout");
                const dateModalEl = $("snDatesModal");

                function syncCheckout() {
                    if (!checkin.value) return;
                    const next = parse(checkin.value);
                    next.setDate(next.getDate() + 1);
                    const minOut = toISO(next);
                    checkout.min = minOut;
                    if (!checkout.value || checkout.value < minOut) checkout.value = minOut;
                }
                checkin.addEventListener("input", syncCheckout);
                checkin.addEventListener("change", syncCheckout);
                checkout.addEventListener("change", () => {
                    if (checkout.value && checkout.min && checkout.value < checkout.min) {
                        checkout.value = checkout.min;
                    }
                });
                syncCheckout();

                dateModalEl.addEventListener("hidden.bs.modal", () => {
                    checkin.value = $("sn-hidden-checkin").value;
                    checkout.value = $("sn-hidden-checkout").value;
                    $("sn-date-error").textContent = "";
                    syncCheckout();
                });

                $("sn-save-dates").addEventListener("click", () => {
                    const inVal = checkin.value, outVal = checkout.value;

                    if (!inVal || !outVal || inVal < toISO(new Date()) || outVal <= inVal) {
                        $("sn-date-error").textContent = "Please choose valid dates.";
                        return;
                    }
                    $("sn-date-error").textContent = "";

                    const inDate = parse(inVal), outDate = parse(outVal);
                    const sameYear = inDate.getFullYear() === outDate.getFullYear();
                    $("sn-display-dates").textContent =
                        (sameYear ? fmtDay(inDate) : fmtFull(inDate)) + " – " + fmtFull(outDate);

                    $("sn-hidden-checkin").value = inVal;
                    $("sn-hidden-checkout").value = outVal;

                    recalc();
                    bootstrap.Modal.getInstance(dateModalEl)?.hide();
                });

                /* ---------- GUESTS ---------- */
                function renderGuests() {
                    $("sn-guest-count").textContent = guests;
                    $("sn-display-guests").textContent = guests + (guests === 1 ? " adult" : " adults");
                    $("sn-hidden-guests").value = guests;
                    $("sn-minus-guest").disabled = guests <= 1;
                    $("sn-plus-guest").disabled = guests >= MAX_GUESTS;
                    recalc();
                }
                $("sn-minus-guest").addEventListener("click", () => { if (guests > 1) { guests--; renderGuests(); } });
                $("sn-plus-guest").addEventListener("click", () => { if (guests < MAX_GUESTS) { guests++; renderGuests(); } });
                renderGuests();

                /* ---------- PRICE BREAKDOWN TOGGLE ---------- */
                const toggle = $("sn-breakdown-toggle");
                const panel = $("sn-breakdown");
                toggle.addEventListener("click", () => {
                    const isOpen = panel.classList.toggle("is-open");
                    toggle.classList.toggle("is-open", isOpen);
                    toggle.setAttribute("aria-expanded", String(isOpen));
                });
            });
        </script>