<% layout("/layouts/boilerplate") -%>

<h2 class="mt-4 title">Your total listings : <%=currUser.listings%></h2>
<div class="row mt-2 g-4">
  <% for(let listing of listings){ %>
    <div class="<%= listings.length === 1
            ? 'col-12 col-md-12 col-lg-12'
            : listings.length === 2
            ? 'col-12 col-sm-6 col-lg-5'
            : 'col-12 col-sm-6 col-lg-4' %>">
      <a class="listing-link" href="/listings/<%= listing._id %>">
        <div class="card col listing-card elevation-2">
          <img src="<%= listing.image.url %>" class="card-img-top elevation-2" alt="StayNest" style="height: 20rem;">
          <div class="card-img-overlay"></div>
          <div class="card-body">
            <p class="card-text title ms-3"><b><%= listing.title %></b></p>
            <p class="card-text title ms-3 price">&#8377; <span class="listing-price" data-price="<%=listing.price %>"><%= listing.price.toLocaleString("en-IN") %></span><small class="gst-label text-muted"></small></p>
          </div>
        </div>
      </a>
    </div>
  <% } %>
</div>
