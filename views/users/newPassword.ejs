<% layout("/layouts/boilerplate") -%>

<div class="row mt-3 title mb-5">
  <div
    class="mt-3 col-8 col-lg-5 col-md-6 col-sm-8 offset-2 offset-lg-3 offset-md-3 offset-sm-2"
  >
    <h3>Change your password</h3>
    <form
      action="/<%= currUser.username %>?_method=PATCH"
      method="POST"
      class="needs-validation"
      novalidate
    >
      <div class="mb-3 mt-4">
        <label for="oldpassword" class="form-label">Old Password</label>
        <input
          type="text"
          id="oldpassword"
          name="oldpassword"
          placeholder="Enter your old password"
          class="form-control"
          required
        />
      </div>
      <div class="mb-3 mt-4">
        <label for="newpassword" class="form-label">New Password</label>
        <input
          type="text"
          id="newpassword"
          name="newpassword"
          placeholder="Create new strong password"
          class="form-control"
          required
        />
      </div>
      <div class="mb-3 mt-4">
        <label for="newpasswordconfirm" class="form-label"
          >Confirm Password</label
        >
        <input
          type="password"
          id="newpasswordconfirm"
          name="newpasswordconfirm"
          placeholder="••••••••"
          class="form-control"
          required
        />
        <div class="invalid-feedback" id="confirmPasswordError">
          Passwords do not match!
        </div>
      </div>
      <button
        class="btn btn-dark mt-3 add-btn btn-red btn-search btn-Change-password"
      >
        Change Password
      </button>
    </form>
  </div>
</div>
