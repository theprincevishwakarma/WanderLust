<% layout("/layouts/boilerplate") -%>

<div class="row mt-3 title mb-5">
  <div
    class="mt-3 col-8 col-lg-5 col-md-6 col-sm-8 offset-2 offset-lg-3 offset-md-3 offset-sm-2"
  >
    <h3>Edit your information</h3>
    <form
      action="/<%= currUser.username %>?_method=PUT"
      method="POST"
      class="needs-validation"
      novalidate
    >
      <div class="row mt-4">
        <div class="col col-12 col-lg-6 mb-4 mb-lg-3">
          <label for="firstname" class="form-label">First Name</label>
          <input
            type="text"
            name="user[name][firstName]"
            id="firstname"
            value="<%=currUser.name.firstName%>"
            class="form-control"
            required
          />
        </div>
        <div class="col col-12 col-lg-6 mb-3">
          <label for="lastname" class="form-label">Last Name</label>
          <input
            type="text"
            name="user[name][lastName]"
            id="lastname"
            value="<%=currUser.name.lastName%>"
            class="form-control"
            required
          />
        </div>
      </div>
      <div class="mb-3 mt-2">
        <label for="email" class="form-label">Email</label>
        <input
          type="email"
          name="user[email]"
          id="email"
          value="<%=currUser.email%>"
          class="form-control"
          autocomplete="email"
          maxlength="254"
          spellcheck="false"
          required
        />
      </div>
      <div class="mb-3 mt-4">
        <label for="username" class="form-label">Usename</label>
        <input
          type="text"
          name="user[username]"
          id="username"
          value="<%=currUser.username%>"
          class="form-control"
          minlength="3"
          maxlength="20"
          pattern="[A-Za-z0-9](?:[A-Za-z0-9_]|[.](?![.])){1,18}[A-Za-z0-9_]"
          autocomplete="username"
          autocapitalize="none"
          spellcheck="false"
          required
        />
      </div>
      <div class="mb-3 mt-4">
        <label for="location" class="form-label">Location</label>
        <input
          type="text"
          id="location"
          name="user[location]"
          value="<%=currUser.location%>"
          class="form-control"
          required
        />
      </div>
      <div class="mb-3 mt-4">
        <label for="phonenumber" class="form-label">Phone Number</label>
        <input
          type="tel"
          id="phonenumber"
          name="user[phoneNo]"
          value="<%=currUser.phoneNo%>"
          class="form-control"
          autocomplete="tel"
          inputmode="tel"
          pattern="[6-9][0-9]{9}"
          maxlength="10"
          required
        />
      </div>
      <button class="btn btn-dark mt-3 add-btn btn-red btn-search">
        Change Info
      </button>
    </form>
  </div>
</div>
